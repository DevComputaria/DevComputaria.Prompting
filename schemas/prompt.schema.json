{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcomputaria/schemas/prompt.schema.json",
  "type": "object",
  "required": ["id", "version", "parts"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "includes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "redacted_in_logs": { "type": "boolean" }
        },
        "required": ["type"]
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "schema_ref": { "type": "string" },
        "inject_as": { "type": "string", "minLength": 1 },
        "inject_format": { "type": "string", "enum": ["compact_example"] }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "attach"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "attach": { "type": "string", "enum": ["system", "tool", "both"] }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "developer", "user"] },
          "template": { "type": "string" },
          "from": { "type": "string", "pattern": "^[^/\\\\]+\\.md$" }
        }
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
